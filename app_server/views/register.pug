extends layout

block content
  h1= title
  p #{message} #[a(href="/login") here] 

  form(action="/" method="POST")
    .form-group.row
      label.col-sm-2.col-form-label(for='inputForename') Forename
      .col-sm-10
        input#inputForename.form-control(
          type='text' 
          name='forename' 
          placeholder='Forename' 
          required
        )  

    .form-group.row
      label.col-sm-2.col-form-label(for='inputPhone') Phone number
      .col-sm-10
        input#inputPhone.form-control(
          type='tel' 
          name='phone' 
          placeholder='Phone number' 
          required
        )  

    .form-group.row
      label.col-sm-2.col-form-label(for='inputEmail') Email
      .col-sm-10
        input#inputEmail.form-control(
          type='email' 
          name='email' 
          placeholder='Email' 
          required
        )  

    .form-group.row
      label.col-sm-2.col-form-label(for='inputPassword') Password
      .col-sm-10
        input#inputPassword.form-control(
          type='password' 
          name='password' 
          placeholder='Password' 
          required
        )  

    .form-group.row
      .col-sm-10
        button.btn.btn-primary(type='submit') Register