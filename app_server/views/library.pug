extends layout
block content

  mixin outputRating(rating)
    - for (let i = 1; i <= 5; i++)
      if i <= rating
        i.fa.fa-star
      else if (i - 0.5) <= rating
        i.fa.fa-star-half-o
      else
        i.fa.fa-star-o 

  .row.banner 
    .col-12    
        h1=pageHeader.title
          small &nbsp;#{pageHeader.strapline}  

  .row 
    .col-12.col-md-8 

    each book in library
      .card 
        .card-block 
          h4=book.name 
            small &nbsp; 
               

            span.badge.badge-pill.badge-default.float-right= book.status 
          
          +outputRating(book.rating)

          p.author= book.author
          
          .genres 
            each genre in book.genres
              span.badge.badge-warning= genre  
             

    .col-12.col-md-4 

      p.lead Looking for a place to store your reading journey? Use our website!